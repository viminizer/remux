# build output
/bin/
/web/dist/
# No trailing slash: in a worktree this is a symlink to the main checkout's
# copy, and a trailing slash matches only a real directory - so the symlink
# was not ignored, and it reached a commit.
/web/node_modules

# home-screen icons, drawn by scripts/gen-icons.py at build time
/web/public/icon-*.png

# go
*.test
*.out

# local state (tsnet node keys, VAPID keys, audit log)
/.config/
*.local.json

# macOS
.DS_Store

# staged UI (scripts/build.sh copies web/dist here for go:embed)
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# node
/web/node_modules/
/web/.test-build/

# Worktrees this tool creates, and anything else it keeps here. They are
# checkouts of this very repo - committing one nests a repository inside
# itself, which git only warns about after the fact.
/.claude/
